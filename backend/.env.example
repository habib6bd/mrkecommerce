SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL example: postgres://user:password@localhost:5432/mrkecommerce
# Leave unset to fall back to a local SQLite database (db.sqlite3)
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000
VERCEL_DOMAIN=

ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Production only ---
# Needed for the Django admin / CSRF-protected views when served behind a proxy
# (Render, Railway, ...). Must include the scheme, e.g. https://api.example.com
CSRF_TRUSTED_ORIGINS=

# These all default to "on" whenever DEBUG=False; override only if your host's
# proxy setup needs something different (e.g. SSL already terminated upstream).
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=2592000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
