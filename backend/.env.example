SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL example: postgres://user:password@localhost:5432/mrkecommerce
# Leave unset to fall back to a local SQLite database (db.sqlite3)
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000
VERCEL_DOMAIN=

ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Rate limit applied to register/login/password-reset endpoints (DRF throttle rate syntax)
AUTH_THROTTLE_RATE=10/min

# Where the frontend's reset-password page lives, used to build the link sent in
# password reset emails, e.g. https://myshop.example.com
FRONTEND_URL=http://localhost:3000

# --- Email (password reset) ---
# Leave EMAIL_HOST unset to print emails to the console (fine for local dev).
# Set these to send real emails via SMTP in production.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@mrkexpressbd.com

# --- Production only ---
# Needed for the Django admin / CSRF-protected views when served behind a proxy
# (Render, Railway, ...). Must include the scheme, e.g. https://api.example.com
CSRF_TRUSTED_ORIGINS=

# These all default to "on" whenever DEBUG=False; override only if your host's
# proxy setup needs something different (e.g. SSL already terminated upstream).
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=2592000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
